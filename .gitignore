# GAME-2341 Prototype 1 — Unity source control
#
# Track Assets/, Packages/, ProjectSettings/, and every .meta file. Unity can
# rebuild the folders below locally; they do not belong in Classroom50.

# Unity-generated and local state
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
[Rr]ecordings/

# Instructor-only local release notes
INSTRUCTOR-PUBLISHING.md

# IDE and operating-system state
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.user
*.userprefs
*.pidb
.DS_Store
Thumbs.db
*.swp
*~

# Unity exports, captures, and packaged course material are not this submission.
*.unitypackage
*.apk
*.aab
*.mp4
*.mov
*.webm
*.gif

# Never ignore .meta files. Unity needs them to preserve references between
# scenes and scripts.

# Exported packages never belong in the repository
*.unitypackage

# Third-party asset packs (licensed; never redistribute). Name the pack in reflection.md instead.
# ponytail: common Synty import roots only; add a pattern when a pack imports elsewhere
[Aa]ssets/[Ss]ynty/
[Aa]ssets/[Ss]ynty.meta
[Aa]ssets/[Ss]ynty[Ss]tudios/
[Aa]ssets/[Ss]ynty[Ss]tudios.meta
[Aa]ssets/POLYGON*/
[Aa]ssets/POLYGON*.meta
[Aa]ssets/Polygon*/
[Aa]ssets/Polygon*.meta
